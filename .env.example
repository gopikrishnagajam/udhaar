# Docker Compose local development. Use a random URL-safe password (letters,
# numbers, underscores and hyphens) because it is included in a connection URL.
POSTGRES_PASSWORD=replace_with_a_random_local_password
POSTGRES_PORT=5432
APP_PORT=8000

# Running Python directly still defaults to SQLite. To use Docker's database,
# set this in the process environment; Python does not automatically load .env.
# UDHAAR_DATABASE_URL=postgresql+psycopg://udhaar:YOUR_PASSWORD@localhost:5432/udhaar
UDHAAR_COOKIE_SECURE=false
# For deployment, allow only your actual domain in your reverse proxy.
