# Docker Compose local development. Use a random URL-safe password (letters,
# numbers, underscores and hyphens) because it is included in a connection URL.
POSTGRES_PASSWORD=replace_with_a_random_local_password
POSTGRES_PORT=5432
APP_PORT=8000
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=replace_with_a_separate_random_local_password

# Docker defaults to Supabase Auth. Credentials come from your development project.
# Authentication uses the publishable key, not a service-role key.
UDHAAR_AUTH_PROVIDER=supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# App invitations and anonymous loan acknowledgments use Resend directly.
# Server-only key with sending permission; use your Resend-verified sender.
RESEND_API_KEY=
UDHAAR_EMAIL_FROM=Udhaar <invites@your-verified-domain.com>
# Recipients must be able to open this URL. Use your public HTTPS app origin.
# For testing on this computer only, http://localhost:8001 is accepted.
UDHAAR_PUBLIC_URL=

# Hosted database: Supabase > Connect > Session pooler (port 5432).
# Fill in the DATABASE password and URL-encode special characters in it.
# Both postgresql:// and postgresql+psycopg:// are accepted. Keep sslmode=require.
# Used only by compose.supabase.yaml; local Compose keeps using Docker Postgres.
SUPABASE_DATABASE_URL=
SUPABASE_APP_PORT=8001
# false for the local HTTP staging test; true behind HTTPS when deployed.
UDHAAR_HOSTED_COOKIE_SECURE=false

# Running Python directly still defaults to SQLite. To use Docker's database,
# set this in the process environment; Python does not automatically load .env.
# UDHAAR_DATABASE_URL=postgresql+psycopg://udhaar:YOUR_PASSWORD@localhost:5432/udhaar
# UDHAAR_DATABASE_SCHEMA=public
# UDHAAR_ENV=development
UDHAAR_COOKIE_SECURE=false
# For deployment, allow only your actual domain in your reverse proxy.
